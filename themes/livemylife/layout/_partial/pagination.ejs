<% if (page.total > 1) { %>
<div class="pagination" role="navigation" aria-label="分页导航">
  <% if (page.prev) { %>
  <a href="<%= url_for(page.prev_link) %>" class="prev">← 上一页</a>
  <% } %>

  <span class="page-number">第 <%= page.current %> 页，共 <%= page.total %> 页</span>

  <% if (page.next) { %>
  <a href="<%= url_for(page.next_link) %>" class="next">下一页 →</a>
  <% } %>
</div>
<% } %>
